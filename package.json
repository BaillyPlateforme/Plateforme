{
  "name": "bailly-plateforme",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:externe": "npm run dev -w @bailly/externe",
    "dev:interne": "npm run dev -w @bailly/interne",
    "build:externe": "npm run build -w @bailly/externe",
    "build:interne": "npm run build -w @bailly/interne",
    "start:externe": "npm run start -w @bailly/externe",
    "start:interne": "npm run start -w @bailly/interne",
    "build": "npm run build:externe && npm run build:interne",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrations": "node scripts/appliquer-migrations.mjs",
    "semer:espace-client": "node scripts/semer-espace-client.mjs",
    "semer:terrain": "node scripts/semer-terrain.mjs",
    "semer:visites": "node scripts/semer-visites.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "16.2.10",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "23.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
