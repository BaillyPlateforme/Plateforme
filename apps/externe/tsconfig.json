{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/lib/*": [
        "../../packages/commun/src/lib/*"
      ],
      "@/components/*": [
        "../../packages/commun/src/components/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/commun/src/**/*.ts",
    "../../packages/commun/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
